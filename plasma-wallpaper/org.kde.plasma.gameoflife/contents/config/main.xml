    <entry name="cellTransitionDuration" type="Int"><default>350</default></entry>
    <entry name="fluidStrength" type="Int"><default>65</default></entry>
    <entry name="fluidSpeed" type="Int"><default>45</default></entry>
    <entry name="initialDensity" type="Int"><default>10</default></entry>
    <entry name="paused" type="Bool"><default>false</default></entry>
    <entry name="connectedCanvas" type="Bool"><default>true</default></entry>
    <entry name="autoSpawn" type="Bool"><default>true</default></entry>
