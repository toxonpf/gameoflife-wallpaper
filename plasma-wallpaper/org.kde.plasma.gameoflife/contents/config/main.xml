    <entry name="cloudSize" type="Int"><default>12</default></entry>
    <entry name="cloudDensity" type="Int"><default>45</default></entry>
    <entry name="animationType" type="Int"><default>1</default></entry>
    <entry name="animationDuration" type="Int"><default>500</default></entry>
    <entry name="animationIntensity" type="Int"><default>70</default></entry>
    <entry name="animationFps" type="Int"><default>30</default></entry>
    <entry name="deathAnimationType" type="Int"><default>7</default></entry>
    <entry name="deathAnimationDuration" type="Int"><default>650</default></entry>
    <entry name="deathAnimationIntensity" type="Int"><default>75</default></entry>
    <entry name="deathEffectColor" type="String"><default>#66ccff</default></entry>
    <entry name="mousePattern" type="Int"><default>0</default></entry>
    <entry name="resetSerial" type="Int"><default>0</default></entry>
    <entry name="clearSerial" type="Int"><default>0</default></entry>
  </group>
</kcfg>
